{
	"logger": {
		"prefix": "log",
		"body": [
			"import logging",
			"logger = logging.getLogger(__name__)"
		],
		"description": "logging"
	},
	"log_level_package": {
		"prefix": "loglevel",
		"body": [
			"logging.getLogger(__package__).setLevel(logging.$1)"
		],
		"description": "logging with specified log level"
	},
	"repo_root_path" : {
		"prefix": "path_root",
		"body": [
			"                  file   < pack <  src < root ",
			"ROOT_DIR = Path(__file__).parent.parent.parent"
		]
	}
}
